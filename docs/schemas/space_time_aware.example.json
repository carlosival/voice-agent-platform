{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "timezone": {
      "type": "string",
      "description": "IANA timezone name, e.g. Europe/Madrid",
      "default": "Europe/Madrid"
    },
    "datetime": {
      "description": "RFC 3339 timestamp, or \"now\" for the current time",
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "const": "now"
        }
      ],
      "default": "now"
    }
  },
  "additionalProperties": false
}


